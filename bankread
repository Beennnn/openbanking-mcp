#!/usr/bin/env python3
"""Lanceur — le vrai programme est dans `bankreadlib/cli.py`.

Ce fichier existe pour que `./bankread` marche depuis un clone, sans rien installer :
c'est ce que fait la configuration MCP, ce que fait l'agent launchd, et ce que fait
quiconque vient de cloner le dépôt pour regarder avant d'installer. Un outil qui lit des
comptes bancaires se lit avant de s'installer.

Une fois le paquet installé (`pipx install .`), la commande `bankread` du PATH pointe
sur le MÊME `main()` — il n'y a pas deux chemins de code à garder d'accord.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from bankreadlib.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
